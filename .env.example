NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nextturn
LOG_LEVEL=info
CLOUDINARY_CLOUD_NAME= # Cloudinary cloud name (from dashboard)
CLOUDINARY_API_KEY= # Cloudinary API key (from dashboard)
CLOUDINARY_API_SECRET= # Cloudinary API secret (from dashboard)
CLOUDINARY_FOLDER= # Optional folder for uploads (e.g. "nextturn-images")
JWT_SECRET= # JWT signing secret for admin auth
BCRYPT_PEPPER= # Optional bcrypt pepper appended to passwords before verify
COOKIE_SAME_SITE= # Optional: strict/lax/none (defaults: none in production)
COOKIE_SECURE= # Optional: true/false (defaults: true in production )

# Email (Nodemailer SMTP) - used to notify admins on new inquiries
SMTP_HOST= # e.g. smtp.gmail.com or sandbox.smtp.mailtrap.io
SMTP_PORT= # e.g. 587 (STARTTLS) or 465 (SSL)
SMTP_SECURE= # Optional: true/false. Defaults to true when port=465
SMTP_USER= # SMTP username
SMTP_PASS= # SMTP password / app password
SMTP_FROM= # Optional: "Nextturn <no-reply@yourdomain.com>" (defaults to SMTP_USER)
ADMIN_EMAILS= # Comma-separated list of admin recipients, e.g. admin@yourdomain.com,ops@yourdomain.com


COMPANY_LOGO_URL=# Company logo URL used in email templates (optional, can be set to a default image URL)
CORS_ALLOWED_ORIGINS= # frontend url , soo thats allowed to get requests from backend