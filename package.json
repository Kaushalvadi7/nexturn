{
  "name": "nextturn",
  "version": "1.0.0",
  "description": "Fresh backend scaffold with Express + Sequelize + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "build:full": "eslint src/ && tsc",
    "start": "node dist/server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "reset:db": "npx sequelize-cli db:migrate:undo:all",
    "lint": "tsc --noEmit --pretty false",
    "lint-fix": "npx prettier --write \"src/**/*.{ts,js,json}\"",
    "format": "npx prettier --write ./src --config ./.prettierrc"
  },
  "nodemonConfig": {
    "ignore": [
      "dist/",
      "logs/"
    ]
  },
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.30",
    "@types/sequelize": "^4.28.20",
    "babel-register": "^6.26.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.3.2",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.12.0",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "tslib": "^2.8.1",
    "winston": "^3.17.0"
  }
}
